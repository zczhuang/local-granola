              "source": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "target_id": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "meeting_id",
              "kind",
              "target_id",
              "base_updated_at",
              "current_markdown",
              "proposed_markdown",
              "status",
              "source",
              "created_at",
              "updated_at",
              "diff"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "pagination": {
            "$ref": "#/$defs/Pagination"
          },
          "proposals": {
            "items": {
              "$ref": "#/$defs/Proposal"
            },
            "type": "array"
          }
        },
        "required": [
          "proposals",
          "pagination"
        ],
        "title": "ProposalPage",
        "type": "object"
      },
      "title": "List proposals"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "CALLS THE LOCAL MODEL. Runs the enhanced-notes pass for one meeting with the Ollama model on this computer (loopback only; any non-loopback Ollama URL is refused) and returns the result in the same shape as get_enhanced_notes with origin \"preview\". NOTHING IS SAVED: the database is not written and the desktop app's notes are untouched. It can take minutes on long meetings. To keep a result, a human applies it in the desktop app; you may stage the markdown with propose_summary_edit, which also stays pending until a human applies it.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "meeting_id": {
            "description": "Anarlog meeting id",
            "type": "string"
          },
          "model": {
            "description": "Ollama model name; defaults to the configured notes model",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "meeting_id"
        ],
        "type": "object"
      },
      "name": "preview_enhanced_notes",
      "outputSchema": {
        "$defs": {
          "AiBullet": {
            "properties": {
              "ai_id": {
                "type": "string"
              },
              "sources": {
                "items": {
                  "$ref": "#/$defs/ResolvedSource"
                },
                "type": "array"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "ai_id",
              "text",
              "sources"
            ],
            "type": "object"
          },
          "EnhancedActionItem": {
            "properties": {
              "ai_id": {
                "type": "string"
              },
              "done": {
                "type": "boolean"
              },
              "due": {
                "description": "Null when the saved document does not record a due date.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "owner": {
                "description": "Null when the saved document does not record an owner.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "sources": {
                "items": {
                  "$ref": "#/$defs/ResolvedSource"
                },
                "type": "array"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "ai_id",
              "text",
              "done",
              "sources"
            ],
            "type": "object"
          },
          "EnhancedNotes": {
            "properties": {
              "action_items": {
                "items": {
                  "$ref": "#/$defs/EnhancedActionItem"
                },
                "type": "array"
              },
              "decisions": {
                "items": {
                  "$ref": "#/$defs/AiBullet"
                },
                "type": "array"
              },
              "document_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "generation": {
                "description": "Raw generation metadata stored with the document (model, digests, ...)."
              },
              "lines": {
                "description": "The user's typed lines in order, each with its AI bullets.",
                "items": {
                  "$ref": "#/$defs/NoteLine"
                },
                "type": "array"
              },
              "markdown": {
                "description": "Markdown rendering with `[^n]` citations; each footnote starts with `[mm:ss]`.",
                "type": "string"
              },
              "meeting_id": {
                "type": "string"
              },
              "open_questions": {
                "items": {
                  "$ref": "#/$defs/AiBullet"
                },
                "type": "array"
              },
              "origin": {
                "description": "`saved` for a stored document, `preview` for an unsaved model run.",
                "type": "string"
              },
              "overview": {
                "description": "AI bullets under the generated Overview (meetings without typed notes).",
                "items": {
                  "$ref": "#/$defs/AiBullet"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              },
              "unresolved_sources": {
                "description": "Number of cited sources whose transcript words could not be found.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "updated_at": {
                "type": "string"
              }
            },
            "required": [
              "meeting_id",
              "title",
              "origin",
              "updated_at",
              "generation",
              "lines",
              "overview",
              "decisions",
              "action_items",
              "open_questions",
              "unresolved_sources",
              "markdown"
            ],
            "type": "object"
          },
          "NoteLine": {
            "properties": {
              "ai_bullets": {
                "items": {
                  "$ref": "#/$defs/AiBullet"
                },
                "type": "array"
              },
              "depth": {
                "description": "Nesting depth of the user's list item (0 for top level).",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "description": "`paragraph`, `heading` or `list_item`.",
                "type": "string"
              },
              "text": {
                "description": "The user's own typed text, never rewritten.",
                "type": "string"
              }
            },
            "required": [
              "text",
              "kind",
              "depth",
              "ai_bullets"
            ],
            "type": "object"
          },
          "ResolvedSource": {
            "description": "A cited stretch of transcript, resolved to speakers, times and words.",
            "properties": {
              "end": {
                "type": "string"
              },
              "end_ms": {
                "format": "int64",
                "type": "integer"
              },
              "end_word_id": {
                "type": "string"
              },
              "resolved": {
                "description": "False when the cited words no longer exist (transcript edited or deleted).",
                "type": "boolean"
              },
              "speakers": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "start": {
                "description": "`mm:ss` (or `h:mm:ss`).",
                "type": "string"
              },
              "start_ms": {
                "format": "int64",
                "type": "integer"
              },
              "start_word_id": {
                "type": "string"
              },
              "text": {
                "description": "The cited transcript words, truncated to about 1200 characters.",
                "type": "string"
              },
              "transcript_id": {
                "type": "string"
              }
            },
            "required": [
              "transcript_id",
              "start_word_id",
              "end_word_id",
              "start_ms",
              "end_ms",
              "start",
              "end",
              "speakers",
              "text",
              "resolved"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "model": {
            "type": "string"
          },
          "notes": {
            "$ref": "#/$defs/EnhancedNotes"
          },
          "saved": {
            "description": "Always false: previews are never written to the database.",
            "type": "boolean"
          },
          "warnings": {
            "description": "Problems worth knowing about, such as dropped unsupported bullets.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "saved",
          "model",
          "warnings",
          "notes"
        ],
        "title": "PreviewEnhancedNotes",
        "type": "object"
      },
      "title": "Preview enhanced notes"
    },
