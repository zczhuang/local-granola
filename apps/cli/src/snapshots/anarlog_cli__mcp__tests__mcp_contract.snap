    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Full-text search over this computer's local Anarlog database: meeting titles, typed notes, enhanced notes, summaries and transcript text. Every word of the query must appear somewhere in a meeting; wrap a phrase in double quotes. Returns meeting id, title, date and snippets (transcript snippets carry an mm:ss time), newest first, paginated. Read-only; no network and no model.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "folder_path": {
            "default": null,
            "description": "Only search meetings in this folder path and its subfolders",
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "description": "Maximum meetings; defaults to 10 and is capped at 50",
            "format": "uint32",
            "maximum": 50,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "description": "Number of matching meetings to skip; defaults to 0",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "query": {
            "description": "Words to find. Every word must appear somewhere in the meeting (title, typed notes, enhanced notes, summaries or transcript). Wrap a phrase in double quotes to match it exactly.",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "search_meetings",
      "outputSchema": {
        "$defs": {
          "Pagination": {
            "properties": {
              "limit": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "next_offset": {
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "offset": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "returned": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "total": {
                "format": "uint",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "offset",
              "limit",
              "returned"
            ],
            "type": "object"
          },
          "SearchHit": {
            "properties": {
              "date": {
                "description": "Meeting start, or its creation time when it has no start.",
                "type": "string"
              },
              "folder_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "meeting_id": {
                "type": "string"
              },
              "snippets": {
                "items": {
                  "$ref": "#/$defs/SearchSnippet"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "meeting_id",
              "title",
              "date",
              "snippets"
            ],
            "type": "object"
          },
          "SearchSnippet": {
            "properties": {
              "document_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "description": "`title`, `typed_notes`, `enhanced_notes`, `summary`, `transcript` or the\ndocument kind for any other document.",
                "type": "string"
              },
              "start_ms": {
                "format": "int64",
                "type": [
                  "integer",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              },
              "time": {
                "description": "`mm:ss` of the matching transcript word (transcript snippets only).",
                "type": [
                  "string",
                  "null"
                ]
              },
              "transcript_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "source",
              "text"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/$defs/SearchHit"
            },
            "type": "array"
          },
          "pagination": {
            "$ref": "#/$defs/Pagination"
          },
          "query": {
            "type": "string"
          },
          "scan_truncated": {
            "description": "True when the bounded scan stopped before inspecting every candidate;\nnarrow the query or folder to see older matches.",
            "type": "boolean"
          }
        },
        "required": [
          "query",
          "hits",
          "pagination",
          "scan_truncated"
        ],
        "title": "SearchPage",
        "type": "object"
      },
      "title": "Search meetings"
    }
  ]
}
