    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Read a meeting's saved enhanced notes from the local database as structured data: the user's own typed lines in order, each with its AI bullets, and each bullet's resolved sources (speaker, start/end time, the cited transcript words), plus decisions, action items (owner and due when recorded) and open questions. Also returns a Markdown rendering with [^n] footnotes whose definitions start with [mm:ss]. Read-only; no network and no model. Fails with not found when the meeting has no enhanced notes.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "document_id": {
            "default": null,
            "description": "Specific enhanced document id; defaults to the most recently updated one",
            "type": [
              "string",
              "null"
            ]
          },
          "meeting_id": {
            "description": "Anarlog meeting id",
            "type": "string"
          }
        },
        "required": [
          "meeting_id"
        ],
        "type": "object"
      },
      "name": "get_enhanced_notes",
      "outputSchema": {
        "$defs": {
          "AiBullet": {
            "properties": {
              "ai_id": {
                "type": "string"
              },
              "sources": {
                "items": {
                  "$ref": "#/$defs/ResolvedSource"
                },
                "type": "array"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "ai_id",
              "text",
              "sources"
            ],
            "type": "object"
          },
          "EnhancedActionItem": {
            "properties": {
              "ai_id": {
                "type": "string"
              },
              "done": {
                "type": "boolean"
              },
              "due": {
                "description": "Null when the saved document does not record a due date.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "owner": {
                "description": "Null when the saved document does not record an owner.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "sources": {
                "items": {
                  "$ref": "#/$defs/ResolvedSource"
                },
                "type": "array"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "ai_id",
              "text",
              "done",
              "sources"
            ],
            "type": "object"
          },
          "NoteLine": {
            "properties": {
              "ai_bullets": {
                "items": {
                  "$ref": "#/$defs/AiBullet"
                },
                "type": "array"
              },
              "depth": {
                "description": "Nesting depth of the user's list item (0 for top level).",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "description": "`paragraph`, `heading` or `list_item`.",
                "type": "string"
              },
              "text": {
                "description": "The user's own typed text, never rewritten.",
                "type": "string"
              }
            },
            "required": [
              "text",
              "kind",
              "depth",
              "ai_bullets"
            ],
            "type": "object"
          },
          "ResolvedSource": {
            "description": "A cited stretch of transcript, resolved to speakers, times and words.",
            "properties": {
              "end": {
                "type": "string"
              },
              "end_ms": {
                "format": "int64",
                "type": "integer"
              },
              "end_word_id": {
                "type": "string"
              },
              "resolved": {
                "description": "False when the cited words no longer exist (transcript edited or deleted).",
                "type": "boolean"
              },
              "speakers": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "start": {
                "description": "`mm:ss` (or `h:mm:ss`).",
                "type": "string"
              },
              "start_ms": {
                "format": "int64",
                "type": "integer"
              },
              "start_word_id": {
                "type": "string"
              },
              "text": {
                "description": "The cited transcript words, truncated to about 1200 characters.",
                "type": "string"
              },
              "transcript_id": {
                "type": "string"
              }
            },
            "required": [
              "transcript_id",
              "start_word_id",
              "end_word_id",
              "start_ms",
              "end_ms",
              "start",
              "end",
              "speakers",
              "text",
              "resolved"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "action_items": {
            "items": {
              "$ref": "#/$defs/EnhancedActionItem"
            },
            "type": "array"
          },
          "decisions": {
            "items": {
              "$ref": "#/$defs/AiBullet"
            },
            "type": "array"
          },
          "document_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "generation": {
            "description": "Raw generation metadata stored with the document (model, digests, ...)."
          },
          "lines": {
            "description": "The user's typed lines in order, each with its AI bullets.",
            "items": {
              "$ref": "#/$defs/NoteLine"
            },
            "type": "array"
          },
          "markdown": {
            "description": "Markdown rendering with `[^n]` citations; each footnote starts with `[mm:ss]`.",
            "type": "string"
          },
          "meeting_id": {
            "type": "string"
          },
          "open_questions": {
            "items": {
              "$ref": "#/$defs/AiBullet"
            },
            "type": "array"
          },
          "origin": {
            "description": "`saved` for a stored document, `preview` for an unsaved model run.",
            "type": "string"
          },
          "overview": {
            "description": "AI bullets under the generated Overview (meetings without typed notes).",
            "items": {
              "$ref": "#/$defs/AiBullet"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "unresolved_sources": {
            "description": "Number of cited sources whose transcript words could not be found.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "meeting_id",
          "title",
          "origin",
          "updated_at",
          "generation",
          "lines",
          "overview",
          "decisions",
          "action_items",
          "open_questions",
          "unresolved_sources",
          "markdown"
        ],
        "title": "EnhancedNotes",
        "type": "object"
      },
      "title": "Get enhanced notes"
    },
    {
