                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "markdown": {
                "type": "string"
              },
              "sort_order": {
                "format": "int64",
                "type": "integer"
              },
              "template_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            },
